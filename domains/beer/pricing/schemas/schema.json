{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hmip.internal/schemas/beer-pricing/beer_price.schema.json",
  "title": "BeerPrice",
  "description": "Validated beer price record produced by PRC-001's validate task. Matches 12_Data_Contract.md section 6.1.",
  "type": "object",
  "required": [
    "product_id",
    "brand",
    "product_name",
    "price",
    "currency",
    "store",
    "capture_time",
    "confidence",
    "source_url",
    "source"
  ],
  "properties": {
    "product_id": { "type": "string", "minLength": 1 },
    "sku": { "type": ["string", "null"] },
    "brand": { "type": "string", "minLength": 1 },
    "product_name": { "type": "string", "minLength": 1 },
    "price": { "type": "number", "exclusiveMinimum": 0 },
    "currency": { "type": "string", "minLength": 1 },
    "store": { "type": "string", "minLength": 1 },
    "province": { "type": ["string", "null"] },
    "capture_time": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "source_url": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
