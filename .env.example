# Example environment variables for HMIP.
# See 09_Deployment_Guide.md section 5. Copy to .env for local runs
# (never commit a real .env — see .dockerignore / .gitignore).

# Runtime environment name (development | staging | production).
HMIP_ENV=development

# Overrides for core/models.py::BootstrapReport's runtime_version /
# kernel_version fields. Optional — falls back to placeholder defaults
# in shared/constants.py if unset (see SPRINT_3_STATUS.md's open
# question about what these should really be tied to).
HMIP_RUNTIME_VERSION=
HMIP_KERNEL_VERSION=

# Log level for core/observability.py's structlog configuration.
HMIP_LOG_LEVEL=INFO

# Secret provider selector. No provider is actually implemented yet —
# core/config.py's secret resolution is a documented pass-through stub
# (see SPRINT_1_STATUS.md). Reserved for when one exists.
HMIP_SECRET_PROVIDER=

# Base directory for config/*.yaml lookups. Defaults to ./config if
# unset.
HMIP_CONFIG_PATH=

# Where domain data pipelines read/write (data/raw, data/normalized,
# etc.). Not currently read by any code — no data pipeline exists yet
# that would use it (listed here because 09_Deployment_Guide.md
# section 5 names it as a standard env var).
HMIP_DATA_DIR=

# Where platform_/bootstrap.py writes BootstrapReport JSON files.
# Defaults to ./reports if unset.
HMIP_REPORT_DIR=

# Where platform_/readiness.py writes/reads its readiness marker file.
# Defaults to a path under the OS temp directory if unset.
HMIP_READY_FILE=
